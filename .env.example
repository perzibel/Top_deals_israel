# Run mode
DRY_RUN=false
POST_INTERVAL_MINUTES=180
MAX_POSTS_PER_RUN=3
POSTS_PER_BATCH=3

# AliExpress - fill after approval
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=telegram_main
ALIEXPRESS_API_ENDPOINT=https://api-sg.aliexpress.com/sync
ALIEXPRESS_SEARCH_METHOD=aliexpress.affiliate.product.query
ALIEXPRESS_LINK_METHOD=aliexpress.affiliate.link.generate

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Ollama - optional, if empty the engine uses basic text templates
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
USE_OLLAMA=true
SOCIAL_MODEL=qwen3:14b
OLLAMA_HOST=http://localhost:11434

# Deal filters
MIN_RATING=4.4
MIN_ORDERS=1000
MAX_PRICE_USD=80
MIN_DISCOUNT_PERCENT=5

KEYWORDS='superdeals,portable charger,lego,gaming, keyboard,car vacuum cleaner,portable tire inflator,dash cam,wireless charger,car sun shade,pet hair remover,dog water bottle,pet grooming brush,automatic pet feeder,pet drinking fountain,kitchen organizer,drawer organizer,air fryer accessories,oil spray bottle,vegetable chopper,spice rack,sink organizer,bathroom organizer,closet organizer,vacuum storage bags,baby night light,baby stroller organizer,baby car mirror,baby safety lock,stroller fan,baby silicone bib,makeup organizer,led makeup mirror,electric hair trimmer,beard trimmer,travel makeup bag,manicure set,mini vacuum cleaner,electric cleaning brush,lint remover,keyboard cleaning kit,microfiber cloth,monitor light bar,laptop stand,cable organizer,desk lamp,desk mat,vertical mouse,travel organizer,packing cubes,travel adapter,luggage scale,passport holder,100w usb c cable,65w gan charger,100w gan charger,power bank,baseus power bank,ugreen charger,magsafe car holder,smart plug,zigbee sensor,security camera,led strip,aqara temperature sensor,mechanical keyboard,ps5 accessories,electric screwdriver,precision screwdriver set,laser level'
BOT_POLL_INTERVAL_SECONDS=4
QUEUE_COOLDOWN_SECONDS=120
MAX_QUEUE_SIZE=50
MIN_DEAL_SCORE_TO_POST=80
PRIORITY_USER_IDS=
SOCIAL_MIN_SCORE=85

AFFILIATE_BACKEND=affiracle_telegram

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_USER_SESSION=affiracle_user_session

AFFIRACLE_BOT_USERNAME=affiracle_affiliates_bot
AFFIRACLE_BOT_TIMEOUT_SECONDS=60
AFFIRACLE_BOT_COOLDOWN_SECONDS=3

USD_TO_ILS=3.7

PRODUCT_SOURCE=aliexpress_api
SEED_PRODUCTS_PATH=data/products_seed.json

SEARCH_PRODUCTS_PER_KEYWORD=10
MIN_PRICE_ILS=10
MAX_PRICE_ILS=250

# Queue / posting automation
POST_INTERVAL_HOURS=3
DISCOVERY_INTERVAL_HOURS=6
POST_ACTIVE_START_HOUR=9
POST_ACTIVE_END_HOUR=22
QUEUE_TARGET_SIZE=50
DISCOVERY_MAX_CANDIDATES_PER_RUN=100
DISCOVERY_INTERVAL_MINUTES=360

CATEGORY_ROTATION_WINDOW=4

# Gadget-first discovery: keywords are sampled from app/services/discovery_pool.py
# (KEYWORDS above is only used when USE_GADGET_POOL=false).
USE_GADGET_POOL=true
DISCOVERY_KEYWORDS_PER_RUN=30
STAPLE_KEYWORD_SHARE=0.2
KEYWORD_COOLDOWN_DAYS=7
KEYWORD_POST_SPACING_DAYS=3
MAX_QUEUED_PER_KEYWORD=2
DUPLICATE_TITLE_SIMILARITY=0.6
DUPLICATE_TITLE_LOOKBACK_DAYS=30
# Hidden gems: fewer orders than MIN_ORDERS, but rated at least this well.
HIDDEN_GEM_MIN_ORDERS=100
HIDDEN_GEM_MIN_RATING=4.7

DISCOVERY_PAGE_MIN=1
DISCOVERY_PAGE_MAX=5
DISCOVERY_PAGE_SIZE=50

# Discovery sources
ENABLE_HOT_PRODUCTS=true
ENABLE_HOT_TOPICS=true

# Limits
HOT_PRODUCTS_LIMIT=50
HOT_TOPICS_LIMIT=50

# Optional: if AliExpress Hot Topics supports topic IDs
HOT_TOPICS_TOPIC_IDS=

HOT_TOPIC_KEYWORDS=cool gadgets,tech gadgets,smart gadgets,car gadgets,gaming gadgets,edc gadgets,diy gadgets,smart home gadgets

TELEGRAM_CHAT_ID=

HOT_PRODUCTS_MAX_PRICE_ILS=250
HOT_PRODUCTS_KEYWORDS=gaming,tech,phone accessories,gadgets,smart home,desk setup,keyboard,mouse,charger,controller,headset,earbuds,smart plug,desk mat
# Queue freshness / reposts
QUEUE_MAX_AGE_DAYS=3
REPOST_COOLDOWN_DAYS=30
REPOST_MIN_DROP_PERCENT=10

# Featured AliExpress promotion campaigns (Brand Day, Big Save, 11.11 ...)
ENABLE_FEATURED_PROMOS=true
FEATURED_PROMO_PATTERNS=big save,bestseller,top brands,superdeal,choice,11.11,sale
FEATURED_PROMOS_PER_RUN=2

# Extra title terms to reject (comma separated), e.g. shoes,insole,dress
BLOCKED_TITLE_TERMS=baby,makeup,תינוק,כלב,חתול,איפור

# Use Ollama's Hebrew description/verdict when it passes validation (else templates)
USE_AI_COPY=true

# DEBUG shows why each product was skipped
LOG_LEVEL=INFO

# Interest filter: only post products in these AliExpress categories.
# First-level ID ("44") or first:second level ("13:200321150"). Empty = everything.
# 202192403 phone accessories, 509 phones, 44 consumer electronics, 7 computer & office,
# 34 automobiles, 30 security, 39 lights, 1420 tools, 13:200321150 smart home, 13:5 electrical
ALLOWED_CATEGORY_IDS=202192403,509,44,7,34,30,39,1420,13:200321150,13:5
